// WeLive LMS domain model.
// BookStack remains the content source of truth (books/chapters/pages, fetched live via API).
// Everything here is LMS-native state BookStack has no concept of: accounts, enrollment, progress, flags.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One row per NGO deployment today (WeLive). Kept as a real table, not a singleton,
// so a future multi-tenant deployment doesn't require a schema change.
model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  bookstackBaseUrl String
  createdAt        DateTime @default(now())

  // Branding — every NGO deployment of this codebase runs on its own server with its
  // own database, so these live here (editable from /admin/settings) rather than as
  // hardcoded strings, letting the same code serve any org. See DESIGN_SYSTEM.md.
  brandName       String  @default("WeLive Learning")
  accentColor     String  @default("#7358b3")
  heroHeading     String  @default("Courses and transition programs, in one place.")
  heroDescription String  @default("Every course here is written and maintained in our wiki. This is where you enroll, track progress, and pick up where you left off.")
  wikiLinkLabel   String  @default("the wiki")
  // Relative paths under /uploads (served from /public) — null falls back to the
  // generated header mark and Next's default favicon respectively.
  logoUrl         String?
  faviconUrl      String?

  users        User[]
  programs     Program[]
  courses      Course[]
  cohorts      Cohort[]
  featureFlags FeatureFlag[]
  customLinks  CustomLink[]
  eventLogs    EventLog[]
}

enum LinkPlacement {
  NAV
  FOOTER
}

// Admin-managed extra links in the header nav or footer — e.g. a "Donate" link or a
// partner site. See /admin/settings.
model CustomLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  placement    LinkPlacement
  label        String
  url          String
  openInNewTab Boolean       @default(true)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
}

enum Role {
  LEARNER
  FACILITATOR
  ADMIN
}

// Learners and facilitators live here — never in BookStack. See plan: two separate
// user pools, since BookStack has no OIDC/session-sharing capability as a provider.
model User {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  role         Role    @default(LEARNER)
  // The technical login key — always set, but only ever shown to a person when they
  // have no email (see lib/username.ts). When email is present it's auto-derived and
  // effectively invisible; login accepts either. See lib/flags.ts for the per-role
  // "email optional" settings that decide which path a given account takes.
  username     String  @unique
  passwordHash String
  name         String
  email        String? @unique
  phone        String?

  // Null until a self-registered account clicks its verification link (see
  // registerAction / lib/tokens.ts). Staff-created accounts (admin/facilitator "add
  // learner", bulk import) get this set at creation instead — a human already vouches
  // for them, so there's nothing to verify. Login is refused while this is null.
  emailVerifiedAt DateTime?

  // Facilitator/admin who created this account — supports youth without personal email.
  createdById String?

  createdAt DateTime @default(now())

  enrollments         Enrollment[]
  progress            Progress[]
  facilitatingCourses CourseFacilitator[]
  facilitatingCohorts CohortFacilitator[]
  cohortMemberships   CohortMember[]
  certificates        Certificate[]
  verificationTokens  VerificationToken[]
  eventLogs           EventLog[]

  @@index([organizationId])
}

model Program {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name String
  slug String

  courses Course[]

  @@unique([organizationId, slug])
}

enum CourseType {
  SELF_PACED
  FACILITATED
  EXTERNAL_LINK
}

// One row per BookStack Book that is tagged lms_publish=true. Metadata only —
// lesson/page bodies are fetched live from BookStack, never duplicated here.
model Course {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  programId      String?
  program        Program?     @relation(fields: [programId], references: [id])

  bookstackBookId Int
  slug            String
  title           String
  description     String?
  coverImageUrl   String?

  type             CourseType @default(SELF_PACED)
  externalUrl      String? // used when type = EXTERNAL_LINK (e.g. a Unithena course link)
  facilitatorEmail String? // default facilitator tagged in BookStack, may differ from assigned facilitators
  durationLabel    String?
  order            Int        @default(0)
  published        Boolean    @default(false)
  // Off by default. When on, learners get "download as .docx" options on the course
  // page — the whole course or a single chapter — to fill in offline and share back.
  // Only meaningful for SELF_PACED/FACILITATED courses (there's nothing local to
  // export for EXTERNAL_LINK ones).
  downloadableWorkbook Boolean @default(false)
  // Off by default, and only meaningful when the org-wide `certificates` feature flag
  // is also on — the flag is the org's "we use certificates at all" switch, this is
  // the per-course "...and this particular course awards one" switch. A learner who
  // reaches 100% completion on a course with both on gets a Certificate row created
  // automatically (see maybeIssueCertificate in lib/certificates.ts); a facilitator or
  // admin can also issue one manually regardless of these toggles.
  certificateEnabled Boolean @default(false)
  lastSyncedAt     DateTime?

  lessons      Lesson[]
  enrollments  Enrollment[]
  facilitators CourseFacilitator[]
  cohorts      CohortCourse[]
  certificates Certificate[]

  @@unique([organizationId, bookstackBookId])
  @@unique([organizationId, slug])
}

// One row per BookStack Page within a published course, used only for progress tracking.
model Lesson {
  id                 String  @id @default(cuid())
  courseId           String
  course             Course  @relation(fields: [courseId], references: [id])
  bookstackPageId    Int
  bookstackChapterId Int?
  // Denormalized from the BookStack chapter, purely for labeling per-chapter
  // workbook downloads (e.g. "Download Chapter 2: Money Management"). Null for
  // pages that sit directly on the book with no chapter.
  chapterTitle       String?
  // The chapter's own intro text in BookStack (Chapter > description_html) —
  // shown to a learner the moment they cross into this chapter's first page, so
  // starting a new session doesn't feel like an unexplained jump. Null when the
  // chapter has no description set, or the page has no chapter.
  chapterDescriptionHtml String?
  title              String
  slug               String
  order              Int     @default(0)
  // Set by sync when this page no longer exists in the BookStack book (deleted or
  // moved out) — never deleted outright, since a learner may already have Progress
  // against it. Hidden from every learner-facing list and excluded from completion
  // counts; reappears automatically if the page comes back in a later sync.
  hidden             Boolean @default(false)

  progress Progress[]

  @@unique([courseId, bookstackPageId])
}

enum EnrollmentSource {
  SELF
  ASSIGNED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

model Enrollment {
  id       String @id @default(cuid())
  learnerId String
  learner  User   @relation(fields: [learnerId], references: [id])
  courseId String
  course   Course @relation(fields: [courseId], references: [id])
  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id])

  source      EnrollmentSource @default(SELF)
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  @@unique([learnerId, courseId])
}

model Progress {
  id          String    @id @default(cuid())
  learnerId   String
  learner     User      @relation(fields: [learnerId], references: [id])
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  viewedAt    DateTime?
  completedAt DateTime?

  @@unique([learnerId, lessonId])
}

// A cohort is a real, standing group of learners now — not just a label copied onto
// individual enrollments. Two independent things can be attached to it:
//   - members (CohortMember): who's in the group
//   - courses (CohortCourse): which courses the group is following
// Attaching a course auto-enrolls every current member; adding a member auto-enrolls
// them in every course the cohort already follows (see lib/cohort-sync.ts). This is
// the same shape as Moodle's "cohort sync" enrolment method — enroll the *group*, not
// each person into each course by hand. Course-level, one-off enrollment (the
// pre-existing EnrollLearnerPanel flow, still tagging Enrollment.cohortId directly)
// keeps working exactly as before for anyone not using cohort-sync — this is additive,
// not a replacement. Gated by the `cohorts` feature flag. See DESIGN_SYSTEM.md.
model Cohort {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String

  startDate DateTime?
  endDate   DateTime?

  enrollments  Enrollment[]
  members      CohortMember[]
  courses      CohortCourse[]
  facilitators CohortFacilitator[]

  // Org-wide now, not per-course, so the name has to be unambiguous org-wide too —
  // this is also what makes "type an existing cohort's name in any course" reuse it
  // instead of silently creating a near-duplicate (see createCohortAction).
  @@unique([organizationId, name])
}

// Standing membership — independent of any specific course enrollment. This is what a
// cohort-restricted facilitator's visibility is actually scoped to (see
// lib/people-permissions.ts), and what lib/cohort-sync.ts auto-enrolls into whichever
// courses the cohort follows.
model CohortMember {
  id        String @id @default(cuid())
  cohortId  String
  cohort    Cohort @relation(fields: [cohortId], references: [id])
  learnerId String
  learner   User   @relation(fields: [learnerId], references: [id])

  @@unique([cohortId, learnerId])
}

// "This cohort follows this course" — attaching one triggers lib/cohort-sync.ts to
// enroll every current member; detaching does *not* retroactively un-enroll anyone
// (same non-destructive principle as deleting a cohort — see cohort-actions.ts).
model CohortCourse {
  id       String @id @default(cuid())
  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id])
  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  @@unique([cohortId, courseId])
}

// A facilitator linked here has their access to this specific cohort's members scoped
// down (see lib/people-permissions.ts) rather than seeing every learner in whatever
// course those members happen to be enrolled in. Whether a given facilitator ends up
// "cohort-restricted" in practice is entirely a consequence of *which* assignment
// type(s) an admin uses for them — this table, CourseFacilitator, or both — not a
// separate mode flag. Mirrors CourseFacilitator's shape deliberately.
model CohortFacilitator {
  id            String @id @default(cuid())
  cohortId      String
  cohort        Cohort @relation(fields: [cohortId], references: [id])
  facilitatorId String
  facilitator   User   @relation(fields: [facilitatorId], references: [id])

  @@unique([cohortId, facilitatorId])
}

model CourseFacilitator {
  id            String @id @default(cuid())
  courseId      String
  course        Course @relation(fields: [courseId], references: [id])
  facilitatorId String
  facilitator   User   @relation(fields: [facilitatorId], references: [id])

  @@unique([courseId, facilitatorId])
}

// Org-scoped module toggles — read by both route guards and nav rendering.
// See plan section 06: "turn it off if you don't need it".
model FeatureFlag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  enabled        Boolean      @default(true)

  @@unique([organizationId, key])
}

// Gated by the `certificates` feature flag (off by default at WeLive launch).
model Certificate {
  id        String   @id @default(cuid())
  learnerId String
  learner   User     @relation(fields: [learnerId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  issuedAt  DateTime @default(now())

  @@unique([learnerId, courseId])
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Single-use, short-lived tokens for email verification and password reset. Only the
// SHA-256 hash of the actual token is ever stored — the raw token lives only in the
// emailed link, so a database read alone can't be used to redeem an outstanding one.
// See lib/tokens.ts.
model VerificationToken {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  tokenHash  String       @unique
  purpose    TokenPurpose
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId, purpose])
}

enum LogLevel {
  INFO
  ERROR
}

// Admin-facing troubleshooting trail — for a support workflow where the person
// reporting a problem ("I can't log in", "I didn't get the email") is rarely able to
// describe it in terms an admin can act on. See lib/log.ts and /admin/logs. Pruned
// automatically (see PRUNE_AFTER_DAYS in lib/log.ts) so this never grows unbounded.
model EventLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Coarse category, not a free-for-all string enum — see LOG_TYPES in lib/log.ts for
  // the fixed set ("LOGIN", "REGISTER", "VERIFY", "PASSWORD_RESET", "EMAIL", "SYNC").
  type    String
  level   LogLevel
  message String
  // Extra machine detail (e.g. the raw Mailgun error) — shown but not required.
  detail  String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Kept even when userId is null (account since deleted, or no account exists yet —
  // e.g. a failed registration) so a lookup by email still works.
  email  String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, level, createdAt])
  @@index([email])
}
