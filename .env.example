# Local dev database (Postgres in production — see DEPLOY.md)
DATABASE_URL="file:./dev.db"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# BookStack — the wiki instance Stackwise pulls courses from
# Create a service-account API token in BookStack: user profile > API Tokens
# (needs the "Access System API" system permission).
BOOKSTACK_BASE_URL="https://wiki.your-org.org"
BOOKSTACK_TOKEN_ID=""
BOOKSTACK_TOKEN_SECRET=""

# Shared secret BookStack's webhook must send back (any random string); wrapper
# rejects sync webhook calls without it.
BOOKSTACK_WEBHOOK_SECRET="replace-with-random-string"

# Seed defaults
ORG_NAME="Your Organization"
ORG_SLUG="default"

# Mailgun — account verification, password reset, and (optionally) emailing new
# accounts their login details. Leave blank in development: sendEmail() logs what
# would have been sent to the console instead of failing, so those flows stay
# testable without real keys.
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_FROM_EMAIL=""
# Use https://api.eu.mailgun.net if your Mailgun domain is in the EU region.
MAILGUN_BASE_URL="https://api.mailgun.net"

# Used to build absolute links in emails (verification, password reset) — set this to
# your real deployed URL in production.
APP_BASE_URL="http://localhost:3000"
